# Low-traffic academic demo split across two OCI Always Free E2 Micro VMs.
# Generate deploy/.env.split with prepare-split-demo-env.ps1; never commit the result.
CARESITTER_ENV_FILE=.env.split
APP_ENVIRONMENT=Development
APP_DOMAIN=localhost
EDGE_SUBNET=172.30.90.0/24
PROXY_IP=172.30.90.10

# Bind data services only to the data VM private VCN address.
DATA_BIND_IP=REPLACE_WITH_DATA_PRIVATE_IPV4
POSTGRES_DB=caresitter
POSTGRES_USER=caresitter
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
ConnectionStrings__CareSitter=Host=REPLACE_WITH_DATA_PRIVATE_IPV4;Port=5432;Database=caresitter;Username=caresitter;Password=REPLACE_WITH_RANDOM_DATABASE_PASSWORD;Timeout=10;Command Timeout=30
Redis__ConnectionString=REPLACE_WITH_DATA_PRIVATE_IPV4:6379,password=REPLACE_WITH_RANDOM_REDIS_PASSWORD,connectTimeout=10000,abortConnect=false

Public__ApiBaseUrl=http://REPLACE_WITH_APP_PUBLIC_IPV4
Cors__AllowedOrigins__0=http://REPLACE_WITH_APP_PUBLIC_IPV4
Jwt__Issuer=caresitter-ip-demo
Jwt__Audience=caresitter-ip-demo
Jwt__SecretKey=REPLACE_WITH_RANDOM_JWT_SECRET_AT_LEAST_32_CHARACTERS
Encryption__EncryptionKey=REPLACE_WITH_RANDOM_ENCRYPTION_KEY_AT_LEAST_32_CHARACTERS

Firebase__ServiceAccountPath=/run/secrets/firebase-service-account.json
Firebase__UseApplicationDefaultCredentials=false
ChatFirestore__ProjectionEnabled=false
ChatFirestore__ClientReadEnabled=false
ChatFirestore__ProjectId=
ChatFirestore__PollSeconds=5
ChatFirestore__BatchSize=25
ChatFirestore__MaxAttempts=8
ChatFirestore__ReconcileEnabled=false
ChatFirestore__ReconcileBatchSize=50

Logging__LogLevel__Default=Warning
Logging__LogLevel__Microsoft.AspNetCore=Warning
ALLOW_DESTRUCTIVE_MIGRATIONS=false
LiveTracking__Enabled=false
NutritionGateway__Enabled=false
Payments__PayOS__Enabled=false
Payments__PayOS__Payout__Enabled=false
Payments__VNPayRefund__Enabled=false
