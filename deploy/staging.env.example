# Copy to deploy/.env on a staging VM. Replace every example value.
APP_ENVIRONMENT=Staging
APP_DOMAIN=staging.example.com
EDGE_SUBNET=172.30.90.0/24
PROXY_IP=172.30.90.10

POSTGRES_DB=caresitter
POSTGRES_USER=caresitter
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
# Keep these passwords synchronized with POSTGRES_PASSWORD and REDIS_PASSWORD.
ConnectionStrings__CareSitter=Host=db;Port=5432;Database=caresitter;Username=caresitter;Password=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
Redis__ConnectionString=redis:6379,password=REPLACE_WITH_RANDOM_REDIS_PASSWORD

Public__ApiBaseUrl=https://staging.example.com
Cors__AllowedOrigins__0=https://staging.example.com
Cors__AllowedOrigins__1=https://customer-staging.example.com
Jwt__Issuer=caresitter-staging
Jwt__Audience=caresitter-staging
Jwt__SecretKey=REPLACE_WITH_RANDOM_JWT_SECRET_AT_LEAST_32_CHARACTERS
Encryption__EncryptionKey=REPLACE_WITH_RANDOM_ENCRYPTION_KEY_AT_LEAST_32_CHARACTERS

Payments__VNPay__TmnCode=REPLACE_WITH_SANDBOX_TMN_CODE
Payments__VNPay__HashSecret=REPLACE_WITH_SANDBOX_HASH_SECRET
Payments__VNPay__PaymentUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
Payments__VNPay__QueryUrl=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
Payments__VNPay__ReturnUrl=https://staging.example.com/api/v1/payments/vnpay/return
Payments__VNPay__IpnUrl=https://staging.example.com/api/v1/payments/vnpay/ipn
Payments__VNPay__CustomerWebUrl=https://customer-staging.example.com
Payments__VNPayRefund__Enabled=false
Payments__VNPayRefund__ApiUrl=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
Payments__VNPayRefund__ServerIpAddress=REPLACE_WITH_STAGING_SERVER_PUBLIC_IP
Payments__VNPayRefund__PollIntervalSeconds=10
Payments__VNPayRefund__RetryDelaySeconds=30
Payments__VNPayRefund__LeaseSeconds=30
Payments__VNPayRefund__BatchSize=10

Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__UserName=REPLACE_WITH_GMAIL_ADDRESS
Smtp__Password=REPLACE_WITH_GMAIL_APP_PASSWORD
Smtp__FromName=CareSitter Staging
Smtp__TimeoutSeconds=15
Google__ClientId=REPLACE_WITH_GOOGLE_CLIENT_ID
Google__ClientSecret=REPLACE_WITH_GOOGLE_CLIENT_SECRET
Google__Web__RedirectUri=https://staging.example.com/api/v1/auth/google/customer/web/callback
Cloudinary__CloudName=REPLACE_WITH_CLOUD_NAME
Cloudinary__ApiKey=REPLACE_WITH_CLOUDINARY_API_KEY
Cloudinary__ApiSecret=REPLACE_WITH_CLOUDINARY_API_SECRET
Firebase__ServiceAccountPath=/run/secrets/firebase-service-account.json
Firebase__UseApplicationDefaultCredentials=false
GEOAPIFY_API_KEY=REPLACE_WITH_GEOAPIFY_API_KEY
ORS_API_KEY=

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
ALLOW_DESTRUCTIVE_MIGRATIONS=false

# Live tracking: chỉ bật sau migration 33; MVP chạy một API instance.
LiveTracking__Enabled=false
LiveTracking__SendIntervalSeconds=10
LiveTracking__LeaseSeconds=120
LiveTracking__RetentionHours=24
LiveTracking__MaxSampleAgeSeconds=60
LiveTracking__MaxFutureSkewSeconds=30

# payOS thu tiền thật. Chỉ bật sau khi có kênh thanh toán, khóa và HTTPS.
Payments__PayOS__Enabled=false
Payments__PayOS__ClientId=
Payments__PayOS__ApiKey=
Payments__PayOS__ChecksumKey=
# Dùng domain Public__ApiBaseUrl, nơi Caddy chuyển tiếp /api/* tới backend.
Payments__PayOS__ReturnUrl=https://staging.example.com/api/v1/payments/payos/return
Payments__PayOS__CancelUrl=https://staging.example.com/api/v1/payments/payos/cancel
# Để trống khi dùng app Android/iOS; điền origin HTTPS khi dùng web khách hàng.
Payments__PayOS__CustomerWebUrl=
Payments__PayOS__Payout__Enabled=false
Payments__PayOS__Payout__ClientId=
Payments__PayOS__Payout__ApiKey=
Payments__PayOS__Payout__ChecksumKey=
Payments__PayOS__Payout__PollIntervalSeconds=5
Payments__PayOS__Payout__QueryDelaySeconds=15
Payments__PayOS__Payout__BatchSize=10
