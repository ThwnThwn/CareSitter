# Copy to deploy/nutrition.env; secrets are separate files prepared by init-secrets.sh.
NUTRITION_ENABLED=false
NUTRITION_ASSESSMENTS_ENABLED=false
NUTRITION_RECOMMENDATIONS_ENABLED=false
# Chỉ bật sau khi data-processing policy và eval provider đạt; file thật không commit.
NUTRITION_HEALTH_PARSER_ENABLED=false
NUTRITION_HEALTH_PARSER_PROVIDER=OpenAI
NUTRITION_HEALTH_PARSER_MODEL=gpt-6-luna
NUTRITION_HEALTH_PARSER_BASE_URL=https://api.openai.com/v1/
NUTRITION_HEALTH_PARSER_API_KEY=
NUTRITION_HEALTH_PARSER_DATA_PROCESSING_APPROVED=false
NUTRITION_HEALTH_PARSER_TIMEOUT_SECONDS=25
NUTRITION_HEALTH_PARSER_MAX_OUTPUT_TOKENS=2048
NUTRITION_HEALTH_PARSER_MAX_ATTEMPTS=2
NUTRITION_HEALTH_PARSER_MAX_CONCURRENCY=4
NUTRITION_HEALTH_PARSER_DAILY_BUDGET=1000
NUTRITION_HEALTH_PARSER_MAX_INPUT_CHARACTERS=12000
NUTRITION_HEALTH_PARSER_MAX_RESPONSE_BYTES=262144
# Only used for authenticated read-only smoke tests. Use a dedicated staging customer.
NUTRITION_SMOKE_OWNER_ID=
NUTRITION_SMOKE_BENEFICIARY_ID=
NUTRITION_SMOKE_TOKEN_FILE=./secrets/nutrition/customer-token
