# Host operations settings (backup, monitoring, compose overlay).
# Copy to deploy/ops.env on the VM and `chmod 600 deploy/ops.env`. Not read by containers.

# Label shown in alerts, e.g. staging / production.
ALERT_ENVIRONMENT_LABEL=staging
# Slack or Discord incoming-webhook URL (both formats supported). Empty = log only.
ALERT_WEBHOOK_URL=

# Encrypted backups. Generate the key pair OFF the VM:
#   age-keygen -o caresitter-backup.key      (keep this private key in the password manager)
#   age-keygen -y caresitter-backup.key > backup-recipient.txt   (copy only this to the VM)
BACKUP_DIRECTORY=/var/backups/caresitter
BACKUP_RECIPIENT_FILE=/opt/caresitter/deploy/secrets/backup-recipient.txt
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_HOURS=26
# rclone remote for the off-host copy, e.g. r2:caresitter-backups/production
# (configure with `rclone config`; use a write-only key and a bucket lifecycle rule).
BACKUP_RCLONE_REMOTE=

DISK_ALERT_PERCENT=85
TLS_MIN_DAYS=14
# Release images kept for instant rollback (besides current and previous).
KEEP_RELEASE_IMAGES=5
# Leave empty to derive https://$APP_DOMAIN/health/ready from deploy/.env.
HEALTH_URL=

# Set to "nutrition" once the Nutrition overlay (deploy/nutrition) runs on this VM.
CARESITTER_COMPOSE_OVERLAY=
