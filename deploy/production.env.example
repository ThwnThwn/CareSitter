# Copy to deploy/.env on a production VM. Replace every example value.
APP_ENVIRONMENT=Production
APP_DOMAIN=admin.example.com
EDGE_SUBNET=172.30.90.0/24
PROXY_IP=172.30.90.10

POSTGRES_DB=caresitter
POSTGRES_USER=caresitter
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
# Keep these passwords synchronized with POSTGRES_PASSWORD and REDIS_PASSWORD.
ConnectionStrings__CareSitter=Host=db;Port=5432;Database=caresitter;Username=caresitter;Password=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
Redis__ConnectionString=redis:6379,password=REPLACE_WITH_RANDOM_REDIS_PASSWORD

Public__ApiBaseUrl=https://admin.example.com
Cors__AllowedOrigins__0=https://admin.example.com
Cors__AllowedOrigins__1=https://customer.example.com
Jwt__Issuer=caresitter-production
Jwt__Audience=caresitter-production
Jwt__SecretKey=REPLACE_WITH_RANDOM_JWT_SECRET_AT_LEAST_32_CHARACTERS
Encryption__EncryptionKey=REPLACE_WITH_RANDOM_ENCRYPTION_KEY_AT_LEAST_32_CHARACTERS

Payments__VNPay__TmnCode=REPLACE_WITH_PRODUCTION_TMN_CODE
Payments__VNPay__HashSecret=REPLACE_WITH_PRODUCTION_HASH_SECRET
Payments__VNPay__PaymentUrl=REPLACE_WITH_VNPAY_PRODUCTION_HTTPS_PAYMENT_URL
Payments__VNPay__QueryUrl=REPLACE_WITH_VNPAY_PRODUCTION_HTTPS_QUERY_URL
Payments__VNPay__ReturnUrl=https://admin.example.com/api/v1/payments/vnpay/return
Payments__VNPay__IpnUrl=https://admin.example.com/api/v1/payments/vnpay/ipn
Payments__VNPay__CustomerWebUrl=https://customer.example.com

Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__UserName=REPLACE_WITH_GMAIL_ADDRESS
Smtp__Password=REPLACE_WITH_GMAIL_APP_PASSWORD
Smtp__FromName=CareSitter
Smtp__TimeoutSeconds=15
Google__ClientId=REPLACE_WITH_GOOGLE_CLIENT_ID
Google__ClientSecret=REPLACE_WITH_GOOGLE_CLIENT_SECRET
Google__Web__RedirectUri=https://admin.example.com/api/v1/auth/google/customer/web/callback
Cloudinary__CloudName=REPLACE_WITH_CLOUD_NAME
Cloudinary__ApiKey=REPLACE_WITH_CLOUDINARY_API_KEY
Cloudinary__ApiSecret=REPLACE_WITH_CLOUDINARY_API_SECRET
Firebase__ServiceAccountPath=/run/secrets/firebase-service-account.json
Firebase__UseApplicationDefaultCredentials=false
GEOAPIFY_API_KEY=REPLACE_WITH_GEOAPIFY_API_KEY
ORS_API_KEY=

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
ALLOW_DESTRUCTIVE_MIGRATIONS=false

# Live tracking: chỉ bật sau migration 33; nhiều API instance cần SignalR backplane.
LiveTracking__Enabled=false
LiveTracking__SendIntervalSeconds=10
LiveTracking__LeaseSeconds=120
LiveTracking__RetentionHours=24
LiveTracking__MaxSampleAgeSeconds=60
LiveTracking__MaxFutureSkewSeconds=30
