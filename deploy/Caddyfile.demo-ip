:80 {
	encode zstd gzip

	# Worker endpoints are reachable only on the internal API network.
	@private path /internal/*
	respond @private 404

	@backend path /api/* /hubs/* /health /health/* /hangfire /hangfire/*
	handle @backend {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy admin:8080
	}
}
