# Staging profile with the Gemini AI features ON.
# Copy to deploy/nutrition.env on the STAGING VM, chmod 600, fill both API keys.
# Production keeps using nutrition.env.example (everything off) until staging is accepted.
#
# Staging must only hold test accounts and synthetic health notes: these flags
# send free-text health notes and candidate menus to Google (outside Vietnam).
# Setting *_DATA_PROCESSING_APPROVED=true is the project owner's sign-off for that.

# --- Đợt 1 (bật ngay): hồ sơ + AI đọc ghi chú sức khỏe -------------------------
NUTRITION_ENABLED=true
NUTRITION_ASSESSMENTS_ENABLED=true

NUTRITION_HEALTH_PARSER_ENABLED=true
NUTRITION_HEALTH_PARSER_PROVIDER=Gemini
NUTRITION_HEALTH_PARSER_MODEL=gemini-3.5-flash-lite
NUTRITION_HEALTH_PARSER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/
NUTRITION_HEALTH_PARSER_API_KEY=
NUTRITION_HEALTH_PARSER_DATA_PROCESSING_APPROVED=true
NUTRITION_HEALTH_PARSER_TIMEOUT_SECONDS=25
NUTRITION_HEALTH_PARSER_MAX_OUTPUT_TOKENS=2048
NUTRITION_HEALTH_PARSER_MAX_ATTEMPTS=2
NUTRITION_HEALTH_PARSER_MAX_CONCURRENCY=4
# Low daily cap on staging to bound cost if a client loops.
NUTRITION_HEALTH_PARSER_DAILY_BUDGET=300
NUTRITION_HEALTH_PARSER_MAX_INPUT_CHARACTERS=12000
NUTRITION_HEALTH_PARSER_MAX_RESPONSE_BYTES=262144

# --- Đợt 2 (chỉ bật SAU khi đã publish catalog được chuyên gia duyệt) -----------
# Recommendations=true makes /health/ready require a published catalog; without one
# the API health gate fails and deploy/deploy.sh rolls the release back.
NUTRITION_RECOMMENDATIONS_ENABLED=false
NUTRITION_MEAL_RANKING_ENABLED=false
NUTRITION_MEAL_RANKING_MODEL=gemini-3.5-flash-lite
NUTRITION_MEAL_RANKING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/
# May reuse the HealthParser Gemini key; a separate key gives separate quota/billing alerts.
NUTRITION_MEAL_RANKING_API_KEY=
NUTRITION_MEAL_RANKING_DATA_PROCESSING_APPROVED=true
NUTRITION_MEAL_RANKING_TIMEOUT_SECONDS=20
NUTRITION_MEAL_RANKING_MAX_OUTPUT_TOKENS=1536
NUTRITION_MEAL_RANKING_MAX_ATTEMPTS=2
NUTRITION_MEAL_RANKING_MAX_CONCURRENCY=4
NUTRITION_MEAL_RANKING_DAILY_BUDGET=300
NUTRITION_MEAL_RANKING_MAX_RESPONSE_BYTES=131072
NUTRITION_MEAL_RANKING_MAX_CANDIDATE_SETS=12

# Only used for authenticated read-only smoke tests. Use a dedicated staging customer.
NUTRITION_SMOKE_OWNER_ID=
NUTRITION_SMOKE_BENEFICIARY_ID=
NUTRITION_SMOKE_TOKEN_FILE=./secrets/nutrition/customer-token
