# Sample values only. Copy the selected keys into deploy/.env.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=caresitter-api
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=10000
KAFKA_PRODUCER_MAX_MESSAGE_BYTES=65536
KAFKA_OUTBOX_BATCH_SIZE=20
KAFKA_OUTBOX_POLL_INTERVAL_MS=2000
KAFKA_OUTBOX_LEASE_SECONDS=60
KAFKA_OUTBOX_RETENTION_DAYS=7
KAFKA_CONSUMER_GROUP=notifications-v1
KAFKA_CONSUMER_MAX_RETRIES=5
KAFKA_CONSUMER_HANDLER_TIMEOUT_MS=30000
KAFKA_CONSUMER_MAX_POLL_INTERVAL_MS=300000
KAFKA_CONSUMER_SHUTDOWN_TIMEOUT_MS=15000
KAFKA_INBOX_RETENTION_DAYS=14
KAFKA_TOPIC_NOTIFICATIONS=caresitter.notifications.events.v1
KAFKA_TOPIC_NOTIFICATIONS_DLQ=caresitter.notifications.events.v1.dlq
KAFKA_TOPIC_PAYMENTS=caresitter.payments.events.v1
KAFKA_TOPIC_PAYMENTS_DLQ=caresitter.payments.events.v1.dlq
KAFKA_TOPIC_NUTRITION=caresitter.nutrition.events.v1
KAFKA_TOPIC_NUTRITION_DLQ=caresitter.nutrition.events.v1.dlq
KAFKA_FLOW_NOTIFICATIONS_ENABLED=false
KAFKA_FLOW_PAYMENTS_ENABLED=false
KAFKA_FLOW_NUTRITION_ENABLED=false
KAFKA_SUPPORT_API_URL=http://api:8080/
KAFKA_INTERNAL_SERVICE_KEY=replace-with-a-random-secret-of-at-least-32-characters
