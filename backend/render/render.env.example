# Render: Root Directory=backend, Dockerfile Path=./Dockerfile.render
# Health Check Path=/health/ready. Retain existing API environment and secret files.
RENDER_NUTRITION_ENABLED=false

# Use a separate Nutrition database and restricted nutrition_app role.
# Supabase: direct or session pooler (port 5432); transaction pooling is incompatible
# with the session advisory locks used by recommendation requests.
# Use SSL Mode=VerifyFull;Root Certificate=/app/supabase-ca.crt;Maximum Pool Size=4.
ConnectionStrings__Nutrition=
Nutrition__Enabled=false
Nutrition__AssessmentsEnabled=false
Nutrition__RecommendationsEnabled=false
NutritionCatalog__LocalDemoEnabled=false
MealGrounding__Enabled=false
MealRanking__Enabled=false
HealthParser__Enabled=false
NutritionKnowledgeAi__Enabled=false

# Enable recommendations only after migrations and a published catalog are verified.
# The container shares existing Jwt__SecretKey/Jwt__Issuer/Jwt__Audience with Nutrition.
# TLS certificates and internal service keys are generated in temporary private storage.
