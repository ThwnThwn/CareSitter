{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CheckIn": {
    "EarlyWindowMinutes": 30,
    "MaxDistanceMeters": 50
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUD_NAME",
    "ApiKey": "YOUR_API_KEY",
    "ApiSecret": "YOUR_API_SECRET"
  },
  "Firebase": {
    "ServiceAccountPath": "",
    "ServiceAccountJson": "",
    "UseApplicationDefaultCredentials": false
  },
  "Matching": {
    "InitialOfferCount": 3,
    "ExpansionOfferCount": 3,
    "OfferLifetimeMinutes": 10,
    "MaxDistanceMeters": 10000,
    "MinimumRating": 3.5,
    "Weights": {
      "Distance": 0.35,
      "Rating": 0.30,
      "SkillMatch": 0.25,
      "Experience": 0.10
    }
  },
  "Routing": {
    "Provider": "Geoapify",
    "CandidateLimit": 10,
    "EnableBackupProvider": false,
    "Geoapify": {
      "BaseUrl": "https://api.geoapify.com",
      "Mode": "motorcycle",
      "Traffic": "free_flow",
      "TimeoutSeconds": 5
    },
    "OpenRouteService": {
      "BaseUrl": "https://api.openrouteservice.org",
      "Profile": "driving-car",
      "TimeoutSeconds": 5
    }
  }
}

