# ============================================================
# CareSitter backend — bien moi truong (copy file nay thanh .env)
# ASP.NET Core map "__" -> ":" (vd ConnectionStrings__CareSitter -> ConnectionStrings:CareSitter)
# File .env duoc nap boi DotNetEnv trong Program.cs.
# ============================================================

# Moi truong chay: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# --- PostgreSQL (can extension PostGIS vi dung NetTopologySuite) ---
# Connection string ma 6 module dung chung (ConnectionStrings:CareSitter)
ConnectionStrings__CareSitter=Host=localhost;Port=5432;Database=caresitter;Username=caresitter;Password=caresitter;Include Error Detail=true

# --- Bao mat ---
# Khoa AES 32 ky tu (256-bit). DOI gia tri nay o moi truong that.
Encryption__EncryptionKey=dev-only-change-me-please-32bytes!

# --- Bien dung cho docker-compose (db local) ---
POSTGRES_DB=caresitter
POSTGRES_USER=caresitter
POSTGRES_PASSWORD=caresitter
POSTGRES_PORT=5432
