# ============================================================
# CareSitter backend — bien moi truong (copy file nay thanh .env)
# ASP.NET Core map "__" -> ":" (vd ConnectionStrings__CareSitter -> ConnectionStrings:CareSitter)
# File .env duoc nap boi DotNetEnv trong Program.cs.
# ============================================================

# Moi truong chay: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# --- PostgreSQL (can extension PostGIS vi dung NetTopologySuite) ---
# Connection string ma 6 module dung chung (ConnectionStrings:CareSitter)
ConnectionStrings__CareSitter=

# --- ngrok (public tunnel cho VNPay IPN khi chạy local) ---
# Lấy authtoken tại: https://dashboard.ngrok.com/get-started/your-authtoken
# Dán token vào NGROK_AUTHTOKEN bên dưới. Không commit file .env thật lên Git.
# Free plan dùng development domain được ngrok gán cho account.
# Sau khi chạy: docker compose up -d ngrok
# Xem public URL bằng: docker compose logs ngrok
NGROK_AUTHTOKEN=

# VNPay Sandbox. Dùng domain ngrok hiện tại cho IPN khi chạy local.
Payments__VNPay__TmnCode=
Payments__VNPay__HashSecret=
Payments__VNPay__PaymentUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
Payments__VNPay__ReturnUrl=http://localhost:5033/api/v1/payments/vnpay/return
Payments__VNPay__IpnUrl=https://YOUR_NGROK_DOMAIN/api/v1/payments/vnpay/ipn

# --- Bao mat ---
# Khoa AES 32 ky tu (256-bit). DOI gia tri nay o moi truong that.
Encryption__EncryptionKey=

# --- JWT Bearer Authentication ---
# Nhà phát hành token (Issuer)
Jwt__Issuer=
# Đối tượng sử dụng token (Audience)
Jwt__Audience=
# Khóa bí mật ký token (Secret Key) - Tối thiểu 32 ký tự
Jwt__SecretKey=
# Thời gian sống của Access Token (phút)
Jwt__ExpiryMinutes=60
# Thời gian sống của Refresh Token (ngày)
Jwt__RefreshTokenExpiryDays=7

# --- Bien dung cho docker-compose (db local) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# --- Gmail SMTP (dung de gui OTP xac thuc) ---
# Dung Gmail App Password (KHONG phai password Gmail thuong).
# Tao App Password tai: https://myaccount.google.com/apppasswords
# (Yeu cau bat 2-Step Verification truoc)
Smtp__Host=smtp.gmail.com
Smtp__Port=
Smtp__UserName=your-gmail@gmail.com
Smtp__Password=xxxx xxxx xxxx xxxx
Smtp__FromName=
Smtp__TimeoutSeconds=

# --- Redis Cache ---
Redis__ConnectionString=localhost:6379,password=caresitter
REDIS_PORT=
REDIS_PASSWORD=
REDISINSIGHT_PORT=

# --- Google OAuth ---
# Tạo OAuth 2.0 Client ID tại: https://console.cloud.google.com/apis/credentials
# Loại: Web application hoặc Android/iOS tùy platform của client
# Chỉ cần Client ID (không cần Client Secret vì dùng Google ID Token verify phía server)
Google__ClientId=

# --- Geoapify Places / Geocoding ---
# Dùng để autocomplete và xác minh địa chỉ thật trước khi lưu booking.
# Geoapify co free plan va khong yeu cau nap truoc/credit card cho muc demo.
Geoapify__BaseUrl=https://api.geoapify.com
GEOAPIFY_API_KEY=

# --- Matching caregiver ---
# So caregiver duoc moi o lan dau sau khi booking duoc confirm thanh toan.
Matching__InitialOfferCount=3
# So caregiver duoc moi them sau khi batch truoc het han.
Matching__ExpansionOfferCount=3
# Thoi gian mot offer con hieu luc (phut).
Matching__OfferLifetimeMinutes=10
# Ban kinh phuc vu mac dinh neu caregiver chua khai bao ServiceRadiusMeters.
Matching__MaxDistanceMeters=10000
# Rating toi thieu; caregiver chua co rating van duoc cho qua de tranh chan cold-start.
Matching__MinimumRating=3.5
# Demo=true cho phep caregiver chua co slot availability van duoc coi la ranh.
# Production nen chuyen thanh false sau khi caregiver khai bao lich day du.
Matching__AllowCaregiversWithoutAvailabilitySlots=false
# Trong so soft ranking. Chi dung tin hieu co du lieu that; acceptance/response se them lai khi co bang thong ke.
Matching__Weights__Distance=0.35
Matching__Weights__Rating=0.30
Matching__Weights__SkillMatch=0.25
Matching__Weights__Experience=0.10

# --- Road-network routing cho matching ---
# Geoapify la provider chinh thuc. Haversine chi dung shortlist, khong dung tinh diem cuoi.
Routing__Provider=Geoapify
Routing__CandidateLimit=10
Routing__EnableBackupProvider=false
Routing__Geoapify__BaseUrl=https://api.geoapify.com
Routing__Geoapify__Mode=motorcycle
Routing__Geoapify__Traffic=free_flow
Routing__Geoapify__TimeoutSeconds=5

# Backup provider that, chi bat khi Routing__EnableBackupProvider=true hoac Provider=Resilient.
Routing__OpenRouteService__BaseUrl=https://api.openrouteservice.org
Routing__OpenRouteService__Profile=driving-car
Routing__OpenRouteService__TimeoutSeconds=5
ORS_API_KEY=

# --- Firebase Cloud Messaging ---
# Dùng để backend gửi push notification qua Firebase Admin SDK.
# Cách dễ nhất cho local/dev: tải service account JSON từ Firebase Console rồi trỏ path tuyệt đối.
Firebase__ServiceAccountPath=
# Hoặc dán nguyên JSON service account vào biến này trên môi trường deploy.
Firebase__ServiceAccountJson=
Firebase__UseApplicationDefaultCredentials=false

# --- Cloudinary (Media Storage & Upload ảnh avatar / CCCD / bằng cấp) ---
# Đăng ký tài khoản tại: https://cloudinary.com (Free tier 25GB)
# Lấy thông số trong Dashboard -> Settings -> API Keys
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

