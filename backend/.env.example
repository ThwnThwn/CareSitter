# ============================================================
# CareSitter backend — bien moi truong (copy file nay thanh .env)
# ASP.NET Core map "__" -> ":" (vd ConnectionStrings__CareSitter -> ConnectionStrings:CareSitter)
# File .env duoc nap boi DotNetEnv trong Program.cs.
# ============================================================

# Moi truong chay: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# --- PostgreSQL (can extension PostGIS vi dung NetTopologySuite) ---
# Connection string ma 6 module dung chung (ConnectionStrings:CareSitter)
ConnectionStrings__CareSitter=

# --- Bao mat ---
# Khoa AES 32 ky tu (256-bit). DOI gia tri nay o moi truong that.
Encryption__EncryptionKey=

# --- JWT Bearer Authentication ---
# Nhà phát hành token (Issuer)
Jwt__Issuer=
# Đối tượng sử dụng token (Audience)
Jwt__Audience=
# Khóa bí mật ký token (Secret Key) - Tối thiểu 32 ký tự
Jwt__SecretKey=
# Thời gian sống của Access Token (phút)
Jwt__ExpiryMinutes=60
# Thời gian sống của Refresh Token (ngày)
Jwt__RefreshTokenExpiryDays=7

# --- Bien dung cho docker-compose (db local) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# --- Gmail SMTP (dung de gui OTP xac thuc) ---
# Dung Gmail App Password (KHONG phai password Gmail thuong).
# Tao App Password tai: https://myaccount.google.com/apppasswords
# (Yeu cau bat 2-Step Verification truoc)
Smtp__Host=smtp.gmail.com
Smtp__Port=
Smtp__UserName=your-gmail@gmail.com
Smtp__Password=xxxx xxxx xxxx xxxx
Smtp__FromName=
Smtp__TimeoutSeconds=

# --- Redis Cache ---
Redis__ConnectionString=localhost:6379,password=caresitter
REDIS_PORT=
REDIS_PASSWORD=
REDISINSIGHT_PORT=

# --- Google OAuth ---
# Tạo OAuth 2.0 Client ID tại: https://console.cloud.google.com/apis/credentials
# Loại: Web application hoặc Android/iOS tùy platform của client
# Chỉ cần Client ID (không cần Client Secret vì dùng Google ID Token verify phía server)
Google__ClientId=
