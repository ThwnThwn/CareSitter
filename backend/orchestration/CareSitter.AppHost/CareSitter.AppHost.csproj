  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.1" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>caresitter-apphost-local</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <ProjectReference Include="../../caresitter-be/ApiHost/CareSitter.ApiHost.csproj" />
    <ProjectReference Include="../../services/nutrition/src/CareSitter.Nutrition/CareSitter.Nutrition.csproj" />
    <ProjectReference Include="../../caresitter-be/Services/NotificationWorker/CareSitter.NotificationWorker.csproj" />
  </ItemGroup>
</Project>
